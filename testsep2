let
    // Define the function with a parameter
    FetchWorkItemDescription = (workItemId as number) as text =>
    let
        // OData Feed URL
        Source = OData.Feed(
            "https://dev.azure.com/daais-program-product-mgmt/AI%20Enablement%20Service%20Portfolio%20Management/_odata/v3.0-preview/WorkItems?$filter=WorkItemId eq " 
            & Number.ToText(workItemId),
            null,
            [Implementation="2.0"]
        ),

        // Extract Description column safely
        DescriptionResult = try Source{0}[Description] otherwise "",

        // Return blank if null
        Description = if DescriptionResult = null or DescriptionResult = "" then "" else DescriptionResult

    in
        Description
in
    FetchWorkItemDescription
