let
    FetchWorkItemDescription = (WorkItemId as number) as text =>
    let
        // Build OData URL
        Source =
            OData.Feed(
                "https://analytics.dev.azure.com/{organization}/{project}/_odata/v3.0-preview/WorkItems?$filter=WorkItemId eq "
                & Number.ToText(WorkItemId),
                null,
                [Implementation="2.0"]
            ),

        // Extract first row
        FirstRow =
            try Source{0} otherwise null,

        // Get description column
        DescriptionResult =
            if FirstRow <> null
            then Record.FieldOrDefault(FirstRow, "Description", "")
            else "",

        Description =
            if DescriptionResult = null or DescriptionResult = ""
            then ""
            else DescriptionResult

    in
        Description
in
    FetchWorkItemDescription
