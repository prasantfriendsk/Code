let
    // Function to fetch Description using OData Feed
    FetchWorkItemDescription = (workItemId as number) as text =>
    let
        Source = OData.Feed(
            "https://analytics.dev.azure.com/daais-program-product-mgmt/AI%20Enablement%20Service%20Portfolio%20Management%20Backlog/_odata/v3.0-preview",
            null,
            [Implementation="2.0"]
        ),

        WorkItems = Source{[Name="WorkItems", Signature="table"]}[Data],

        // Filter specific work item
        FilteredRow = Table.SelectRows(
            WorkItems,
            each [WorkItemId] = workItemId
        ),

        // Get Description safely
        DescriptionResult =
            try FilteredRow{0}[Description]
            otherwise "",

        Description =
            if DescriptionResult = null
            then ""
            else DescriptionResult

    in
        Description

in
    FetchWorkItemDescription
